+STATIC
+VOID
+DrawBootMarker (
+  IN EFI_GRAPHICS_OUTPUT_PROTOCOL  *Gop,
+  IN UINTN                          Slot,
+  IN UINT32                         Color
+  )
+{
+  UINT32  Pixels[64 * 64];
+  UINTN   Index;
+  UINTN   X;
+
+  if (Gop == NULL || Gop->Mode == NULL || Gop->Mode->Info == NULL) {
+    return;
+  }
+
+  if (Gop->Mode->Info->HorizontalResolution < (Slot + 1) * 64) {
+    return;
+  }
+
+  X = Gop->Mode->Info->HorizontalResolution - ((Slot + 1) * 64);
+  for (Index = 0; Index < ARRAY_SIZE (Pixels); Index++) {
+    Pixels[Index] = Color;
+  }
+
+  Gop->Blt (Gop, (EFI_GRAPHICS_OUTPUT_BLT_PIXEL *)Pixels, EfiBltBufferToVideo,
+            0, 0, X, 0, 64, 64, 0);
+}
