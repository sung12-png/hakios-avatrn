## @file
#  Bridge Qualcomm ButtonsDxe (SimpleTextInputEx) into the legacy ConIn that
#  Windows Boot Manager reads. Any button press is reported as Enter.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ButtonKeyDxe
  FILE_GUID                      = 8E4C0A31-5B7D-4E62-9C1F-2A7B6D3E9F14
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = ButtonKeyEntry

[Sources]
  ButtonKeyDxe.c

[Packages]
  MdePkg/MdePkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib

[Protocols]
  gEfiSimpleTextInProtocolGuid
  gEfiSimpleTextInputExProtocolGuid

[Depex]
  TRUE
